{
  "name": "mtg-fannable-cards",
  "version": "0.1.0",
  "private": true,
  "description": "Generate Magic: The Gathering cards in a fannable style, with a stat bar on the left edge",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "node --watch src/server/index.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run lint && npm run format:check && npm test",
    "spike:render": "node spikes/rendering/run.js",
    "spike:preview": "node spikes/fixture-preview/run.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.9",
    "canvas": "^3.2.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "allowScripts": {
    "canvas@3.2.3": true
  }
}
