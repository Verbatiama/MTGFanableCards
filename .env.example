# Copy to .env and adjust. Every setting is optional.

# Image tag: latest (releases), vX.Y.Z, or main (every push to main).
FANNABLE_TAG=latest

# Where the app listens on the host. With the Caddy profile, keep it private:
# APP_PORT=127.0.0.1:3000
APP_PORT=3000

# HTTPS with Caddy: uncomment both.
# COMPOSE_PROFILES=caddy
# DOMAIN=cards.example.com

# Fit the app on a 1 GB server (see docs/self-hosting.md): one batch at a
# time (MAX_RUNNING_JOBS defaults to 1), and previews pause for about 10
# seconds during the daily data update.
# LOW_MEMORY=false

# Render batches in the visitor's browser instead of on the server (see
# docs/self-hosting.md): jobs are off, and the browser builds cards.zip and
# cards.pdf itself. It still gets every card, art and symbol from this server,
# never from Scryfall.
# FRONTEND_RENDER=false

# App settings (defaults shown); 0 turns a limit off.
# ART_CACHE_MAX_GB=10
# MAX_BODY_KB=64
# MAX_CARDS_PER_JOB=250
# MAX_RUNNING_JOBS=2
# JOB_TTL_MINUTES=60
# SCRYFALL_REFRESH_HOURS=24
# RATE_LIMIT_JOBS_PER_HOUR=10
# RATE_LIMIT_PREVIEW_PER_MINUTE=120
# RATE_LIMIT_ASSETS_PER_MINUTE=600
# TRUST_PROXY=
